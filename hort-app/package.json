{
  "name": "hort-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/istok-web": "^0.4.1",
    "@expo-google-fonts/poppins": "^0.4.1",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/http.test.mts && node --experimental-strip-types tests/contract.test.mts",
    "format:check": "prettier --check src tests app.json package.json tsconfig.json eslint.config.js",
    "contracts:generate": "node scripts/api-contract.mjs generate",
    "contracts:check": "node scripts/api-contract.mjs check && tsc --project tsconfig.contracts.json --noEmit",
    "contracts:update": "node scripts/api-contract.mjs update",
    "api:check": "node scripts/check-api.mjs"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
}
